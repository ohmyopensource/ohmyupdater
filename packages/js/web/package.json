{
  "name": "@ohmyopensource/ohmyupdater-web",
  "version": "0.2.0",
  "description": "OhMyUpdater! adapter for web applications: signed update notifications in the browser.",
  "keywords": [
    "update",
    "updater",
    "update-notification",
    "browser",
    "angular",
    "react",
    "minisign"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmyopensource/ohmyupdater.git",
    "directory": "packages/js/web"
  },
  "homepage": "https://github.com/ohmyopensource/ohmyupdater#readme",
  "bugs": {
    "url": "https://github.com/ohmyopensource/ohmyupdater/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ohmyopensource/ohmyupdater-core": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
