{
  "name": "@ohmyopensource/ohmyupdater-core",
  "version": "0.1.0",
  "description": "OhMyUpdater! core: manifest validation, minisign signature verification and update status.",
  "keywords": [
    "update",
    "updater",
    "auto-update",
    "minisign",
    "ed25519",
    "signature",
    "semver"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ohmyopensource/ohmyupdater.git",
    "directory": "packages/js/core"
  },
  "homepage": "https://github.com/ohmyopensource/ohmyupdater#readme",
  "bugs": {
    "url": "https://github.com/ohmyopensource/ohmyupdater/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
